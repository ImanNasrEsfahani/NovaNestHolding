# Public URLs embedded in the Next.js build.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DJANGO_HOST_URL=http://localhost:8000

# Django
DJANGO_SECRET_KEY=change-this-to-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# MySQL
DB_NAME=novanest_db
DB_USER=novanest_user
DB_PASSWORD=change-this-database-password
DB_ROOT_PASSWORD=change-this-root-password
DB_VOLUME_NAME=novanest_mysql_data

# Persistent uploaded files
MEDIA_VOLUME_NAME=novanest_backend_media

# Email (optional for local development)
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=
MAILGUN_ADMIN_RECIPIENTS=info@novanestventure.com
