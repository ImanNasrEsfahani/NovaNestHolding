[Unit]
Description=Update NovaNestHolding frontend source and image from GitHub / GHCR
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=landatripadmin
WorkingDirectory=/var/www/novanestholding.com
ExecStart=/usr/bin/bash /var/www/novanestholding.com/scripts/update-frontend-from-ghcr.sh
TimeoutStartSec=1800
